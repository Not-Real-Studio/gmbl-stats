{
  "name": "@gmbl/gm-stats",
  "version": "0.4.1",
  "description": "Slot simulation statistics core: buckets, aggregation, merge, manifests, run panel, sheet ports.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "development": {
        "types": "./src/api-port.ts",
        "default": "./src/api-port.ts"
      },
      "types": "./dist/api-port.d.ts",
      "default": "./dist/api-port.js"
    },
    "./gas": "./dist/gm-stats.gas.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-gas.mjs",
    "build:gas": "node build-gas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "author": "Not Real Studio"
}
